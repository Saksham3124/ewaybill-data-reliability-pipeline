# =============================================================================
# E-Way Bill Data Reliability Pipeline - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and populate with your environment-specific values.
# NEVER commit .env to version control.
# =============================================================================

# Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ewaybill_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# Email Alerting Configuration
# Set to 'true' in staging/production to enable SMTP dispatch
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_USE_TLS=true
ALERT_SENDER_EMAIL=pipeline-alerts@your-domain.com
ALERT_RECIPIENT_EMAILS=data-reliability-team@your-domain.com,oncall@your-domain.com
